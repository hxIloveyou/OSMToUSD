{
  "format": "sharded",
  "compose_into_world": false,
  "shard_grid": {
    "align_with": "LOD0",
    "cell_size_m": 200
  },
  "runtime_api": {
    "enabled": true,
    "cache": {
      "memory": true,
      "disk": true
    }
  },
  "feature_to_shard": "centroid_in_cell",
  "outputs": {
    "schema": "catalog/osm_attr_schema.json",
    "index": "catalog/index/shard_manifest.json",
    "shards_dir": "catalog/shards/"
  }
}
